# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment and local configuration
.env
.env.*
!.env.example
.venv/
.venv*/
venv/

# Python caches and build output
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg-info/

